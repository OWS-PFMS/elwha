# Elwha builds on JDK 21.
#
# Not a preference — two hard constraints:
#   1. All four CI workflows pin temurin 21, so local must match or you are
#      testing a different build than the one that gates merges.
#   2. Spotless' google-java-format calls javac internals. On JDK 25 it dies with
#      NoSuchMethodError: Log$DeferredDiagnosticHandler.getDiagnostics() — a
#      signature change, not module encapsulation, so --add-exports cannot fix it.
#
# This is independent of maven.compiler.release=21, which governs bytecode output
# and holds regardless of which JVM runs Maven. This file governs the JVM.

if JDK21="$(/usr/libexec/java_home -v 21 2>/dev/null)"; then
  export JAVA_HOME="$JDK21"
  PATH_add "$JAVA_HOME/bin"
else
  log_error "JDK 21 not found. Install it, or Spotless will fail under the default JDK."
fi
