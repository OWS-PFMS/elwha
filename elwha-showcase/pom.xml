<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.owspfm</groupId>
    <artifactId>elwha-parent</artifactId>
    <version>1.1.2</version>
  </parent>

  <artifactId>elwha-showcase</artifactId>
  <packaging>jar</packaging>

  <name>Elwha Showcase</name>
  <description>The runnable Elwha storefront — the Showcase, every component playground, and the story-time demo/smoke/diagnostic mains — packaged apart from the library artifact. A classpath-only application jar: it shares package names with com.owspfm:elwha (§2.6 of the artifact-split design) and deliberately declares no Automatic-Module-Name.</description>
  <url>https://github.com/OWS-PFMS/elwha</url>

  <!-- §2.7: elwha plus flatlaf-extras (three playground files import FlatSVGIcon directly —
       used directly, so declared directly rather than leaning on transitivity). flatlaf itself
       flows transitively through elwha. Test scope: the junit/assertj/cacio trio comes from the
       parent; the shared testkit fixtures arrive by source inclusion (build-helper below), NOT
       by the elwha test-jar the design doc's §3.2 chose. Measured conflict: exec:java declares
       ResolutionScope.TEST, and Maven's ReactorReader only substitutes a sibling's
       target/test-classes once test-compile has run in the same session — so a test-jar
       dependency here makes the §1.5 invariant invocation `mvn compile exec:java` fail
       dependency resolution on every cold tree. The test-jar itself is still produced and
       published by elwha (§3.2/§5.1); only this module's consumption mechanism differs. -->
  <dependencies>
    <dependency>
      <groupId>com.owspfm</groupId>
      <artifactId>elwha</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf-extras</artifactId>
      <version>${flatlaf.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The testkit consumption path (see the dependency comment above): compile the shared
             fixtures from the library's test tree, restricted by the compiler's testIncludes so
             none of the ~200 per-component test classes ride along. Anchored the same way as the
             parent's Checkstyle config and LICENSE resource (§1.3). -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-testkit-sources</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>${maven.multiModuleProjectDirectory}/elwha/src/test/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <testIncludes>
            <include>com/owspfm/elwha/showcase/**</include>
            <include>com/owspfm/elwha/testkit/**</include>
          </testIncludes>
          <testExcludes>
            <!-- The testkit's own self-tests (e.g. PixelsRenderTest) stay in elwha's suite —
                 compiled here they would land in this module's test-classes and surefire would
                 run them a second time. -->
            <exclude>com/owspfm/elwha/testkit/**/*Test.java</exclude>
          </testExcludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- The runnable-jar entry point. The plain jar still needs its deps on the
                   classpath; the self-contained shaded -app.jar is P2-S3 (§5.2). No
                   Automatic-Module-Name here — this jar splits packages with elwha and is
                   documented classpath-only (§2.6). -->
              <Main-Class>com.owspfm.elwha.showcase.ElwhaShowcase</Main-Class>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <!-- §5.2 of the artifact-split design [LOCKED]: the evaluator download is an *attached*
             shaded jar, classifier app — the plain jar above stays the module's main artifact,
             byte-for-byte untouched, so Maven consumers resolving com.owspfm:elwha-showcase get
             a normal jar with normal transitive deps while evaluators get one double-clickable
             elwha-showcase-<v>-app.jar. No relocation: the fat jar is an application, not a
             dependency. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>app-jar</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>app</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <!-- Fat-jar hygiene: a merged jar's signatures could never verify, and the
                       dependencies' module descriptors (flatlaf, flatlaf-extras, jsvg all ship
                       one) would each lie about a jar that splits packages and is documented
                       classpath-only (§2.6) — strip both. -->
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
                <!-- LICENSE/NOTICE carriage. §5.2 named the ApacheLicense/ApacheNotice
                     transformers for this; measured, both corrupt: the license transformer
                     swallows every META-INF/LICENSE (Elwha's own included) and emits nothing,
                     and the notice transformer injects an ASF developed-at attribution that is
                     false here. Filters instead: this module's own META-INF/LICENSE and NOTICE
                     (#774, via the parent's resource block) ride through verbatim, while the
                     byte-identical copies in the elwha jar and FlatLaf's Apache-2.0 LICENSE
                     (the same licence text the kept file carries; FlatLaf ships no NOTICE) are
                     dropped rather than collide. -->
                <filter>
                  <artifact>com.owspfm:elwha</artifact>
                  <excludes>
                    <exclude>META-INF/LICENSE</exclude>
                    <exclude>META-INF/NOTICE</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>com.formdev:*</artifact>
                  <excludes>
                    <exclude>META-INF/LICENSE</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>com.github.weisj:jsvg</artifact>
                  <excludes>
                    <exclude>META-INF/LICENSE</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.owspfm.elwha.showcase.ElwhaShowcase</mainClass>
                </transformer>
                <!-- jsvg is MIT, not Apache — its licence text must ride in a jar that embeds
                     its classes, at a path that cannot collide with the Apache LICENSE.
                     src/main/licenses/jsvg-LICENSE is the verbatim META-INF/LICENSE from the
                     jsvg jar (outside src/main/resources deliberately, so the plain jar stays
                     untouched); re-copy it if ${flatlaf.version}'s transitive jsvg ever bumps. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>META-INF/licenses/jsvg-LICENSE</resource>
                  <file>src/main/licenses/jsvg-LICENSE</file>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- §1.5 re-enable: the parent's pluginManagement skips exec reactor-wide; the module
             holding the runnable mains flips it back on. The exec.mainClass default stays a
             parent property — exec:java validates its required mainClass parameter on every
             reactor project before consulting skip. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
