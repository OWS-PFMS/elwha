<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.owspfm</groupId>
  <artifactId>elwha</artifactId>
  <version>1.0.1</version>
  <packaging>jar</packaging>

  <name>Elwha</name>
  <description>A Swing component library implementing Material 3 Expressive on FlatLaf — a design-token foundation plus ~25 components, with the containers, overlays, and anchors around them.</description>
  <url>https://github.com/OWS-PFMS/elwha</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>cfb3</id>
      <name>Charles Bryan</name>
      <email>cfb3@uw.edu</email>
      <organization>Open Water Systems</organization>
      <organizationUrl>https://openwatersystems.com</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/OWS-PFMS/elwha.git</connection>
    <developerConnection>scm:git:ssh://github.com:OWS-PFMS/elwha.git</developerConnection>
    <url>https://github.com/OWS-PFMS/elwha/tree/main</url>
  </scm>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <flatlaf.version>3.2.5</flatlaf.version>
    <junit.version>6.1.2</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <cacio.version>2.0</cacio.version>
    <surefire.version>3.5.4</surefire.version>
    <!-- Tier B (gui-tagged) forked-JVM flags: Cacio's virtual toolkit needs these opens/exports
         on JDK 21 (per its README), and the toolkit swap only works in a JVM where no other test
         has initialized AWT — hence the separate surefire execution below. -->
    <cacio.argline>--add-exports=java.desktop/java.awt=ALL-UNNAMED --add-exports=java.desktop/java.awt.peer=ALL-UNNAMED --add-exports=java.desktop/sun.awt.image=ALL-UNNAMED --add-exports=java.desktop/sun.java2d=ALL-UNNAMED --add-exports=java.desktop/java.awt.dnd.peer=ALL-UNNAMED --add-exports=java.desktop/sun.awt=ALL-UNNAMED --add-exports=java.desktop/sun.awt.event=ALL-UNNAMED --add-exports=java.desktop/sun.awt.datatransfer=ALL-UNNAMED --add-exports=java.base/sun.security.action=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.desktop/java.awt=ALL-UNNAMED --add-opens=java.desktop/sun.java2d=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED -XX:+EnableDynamicAgentLoading</cacio.argline>
    <!-- Which display stack hosts the gui-tagged tier (see testkit/GuiToolkit): "cacio" (the
         virtual toolkit — macOS/Windows dev default) or "native" (real toolkit + real display).
         Linux MUST use native (under Xvfb on CI): the JDK 21 X11 font natives depend on JNI
         state that only real X11 display init registers, so any font-manager construction under
         Cacio segfaults there (hs_err frame: Java_sun_awt_FcFontManager_getFontPathNative).
         Full derivation: docs/research/elwha-test-suite-research.md §5. -->
    <guitier.toolkit>cacio</guitier.toolkit>
  </properties>

  <profiles>
    <profile>
      <id>linux-gui-native</id>
      <activation>
        <os><name>Linux</name></os>
      </activation>
      <properties>
        <guitier.toolkit>native</guitier.toolkit>
      </properties>
    </profile>
  </profiles>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf</artifactId>
      <version>${flatlaf.version}</version>
    </dependency>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf-extras</artifactId>
      <version>${flatlaf.version}</version>
    </dependency>
    <dependency>
      <groupId>com.formdev</groupId>
      <artifactId>flatlaf-intellij-themes</artifactId>
      <version>${flatlaf.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.caciocavallosilano</groupId>
      <artifactId>cacio-tta-jdk21</artifactId>
      <version>${cacio.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub OWS-PFMS Apache Maven Packages</name>
      <url>https://maven.pkg.github.com/OWS-PFMS/elwha</url>
    </repository>
  </distributionManagement>

  <build>
    <resources>
      <!-- Declaring any <resource> replaces the default, so the standard tree comes first. -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- #774: Apache-2.0 distribution convention — LICENSE and NOTICE ride inside the jar
           (and the sources jar) at META-INF/, sourced from the repo root so there is no
           second copy to drift. -->
      <resource>
        <directory>${project.basedir}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifestEntries>
              <!-- #774: a stable JPMS name for module-path consumers; without it the module
                   name derives from the jar filename. -->
              <Automatic-Module-Name>com.owspfm.elwha</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
        </configuration>
      </plugin>
      <plugin>
        <!-- Report-only (#536): no coverage threshold while the suite grows from zero.
             prepare-agent populates ${argLine}; the gui-tier execution chains it via @{argLine}. -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>jacoco-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <executions>
          <execution>
            <!-- Tier A — pure headless: construction, geometry, pixel probes on offscreen
                 BufferedImages, a11y shapes, event contracts. No display, no extra toolkit. -->
            <id>default-test</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <excludedGroups>gui</excludedGroups>
              <systemPropertyVariables>
                <java.awt.headless>true</java.awt.headless>
              </systemPropertyVariables>
            </configuration>
          </execution>
          <execution>
            <!-- Tier B — Cacio virtual toolkit: real window peers, real focus, Robot input.
                 Separate forked JVM per class: the AWT toolkit is a per-JVM singleton, and mixing
                 Cacio with an already-initialized JDK toolkit segfaults (documented upstream). -->
            <id>gui-test</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <groups>gui</groups>
              <reuseForks>false</reuseForks>
              <systemPropertyVariables>
                <java.awt.headless>false</java.awt.headless>
                <cacio.managed.screensize>1920x1080</cacio.managed.screensize>
                <elwha.guiTier.toolkit>${guitier.toolkit}</elwha.guiTier.toolkit>
              </systemPropertyVariables>
              <!-- @{argLine} late-binds JaCoCo's agent injection; hardcoding the value would
                   silently disable coverage for this tier (research doc §8). -->
              <argLine>@{argLine} ${cacio.argline}</argLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <!-- Ratchet (#529 Phase 0): errors are zero and stay zero — doclint on, failures fatal.
               Warnings still print (the missing-docs debt is tracked by the #529 stories) but do
               not fail the build until the epic's final failOnWarnings flip. -->
          <doclint>all</doclint>
          <failOnError>true</failOnError>
          <!-- #774: the Automatic-Module-Name manifest entry makes the javadoc plugin treat the
               project as a JPMS module (module-path + patch-module), under which the
               package-info-only root package fails with "No source files". legacyMode keeps the
               docs build on the classpath — the jar manifest entry is unaffected. -->
          <legacyMode>true</legacyMode>
          <!-- #96 — the final #529 ratchet: with card/v1 gone the tree is doclint-warning-free,
               and failOnWarnings keeps it that way. The <tags> declarations make the house
               @version/@since-on-every-member convention legal to javadoc (placement "a" = all);
               without them the standard tags are class-level-only and every member tag warns. -->
          <failOnWarnings>true</failOnWarnings>
          <tags>
            <tag>
              <name>version</name>
              <placement>a</placement>
              <head>Version:</head>
            </tag>
            <tag>
              <name>since</name>
              <placement>a</placement>
              <head>Since:</head>
            </tag>
          </tags>
          <!-- #547: the landing page of the published javadoc jar (component index + quick
               start) instead of a bare package list. -->
          <overview>${project.basedir}/src/main/javadoc/overview.html</overview>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>2.46.1</version>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/com/owspfm/**/*.java</include>
              <include>src/test/java/com/owspfm/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <style>GOOGLE</style>
              <reflowLongStrings>true</reflowLongStrings>
            </googleJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>10.21.0</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>${project.basedir}/config/checkstyle/checkstyle.xml</configLocation>
          <sourceDirectories>
            <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
            <sourceDirectory>${project.basedir}/src/test/java</sourceDirectory>
          </sourceDirectories>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
          <failsOnError>true</failsOnError>
          <failOnViolation>true</failOnViolation>
          <violationSeverity>warning</violationSeverity>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-advisory</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
